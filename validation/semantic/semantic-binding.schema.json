{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinema-and-series.local/schemas/semantic-binding-v0.1.json",
  "title": "Cinema and Series Semantic Binding Overlay v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "entities", "bindings"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^VC-[0-9]{4,}$"},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_ref", "entity_kind", "label"],
        "properties": {
          "local_ref": {"type": "string", "minLength": 1},
          "entity_kind": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1}
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id"],
        "properties": {
          "assertion_id": {"type": "string", "minLength": 1},
          "subject_ref": {"type": "string", "minLength": 1},
          "object_ref": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinema-and-series.local/schemas/engine-observation-v0.1.json",
  "title": "Cinema and Series Engine Observation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "adapter", "generated_at", "entities"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^VC-[0-9]{4,}$"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_ref", "exact_identity_key"],
        "properties": {
          "local_ref": {"type": "string", "minLength": 1},
          "exact_identity_key": {"type": "string", "minLength": 1},
          "underlying_work_key": {"type": "string", "minLength": 1},
          "series_lineage_key": {"type": "string", "minLength": 1},
          "cas_entity_id": {"type": ["string", "null"]}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_ref", "predicate", "object_ref"],
        "properties": {
          "subject_ref": {"type": "string"},
          "predicate": {"type": "string"},
          "object_ref": {"type": "string"}
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_ref", "predicate", "value"],
        "properties": {
          "subject_ref": {"type": "string"},
          "predicate": {"type": "string"},
          "value": {}
        }
      }
    },
    "preserved_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_ref", "predicate", "values"],
        "properties": {
          "subject_ref": {"type": "string"},
          "predicate": {"type": "string"},
          "values": {"type": "array", "minItems": 1}
        }
      }
    },
    "non_overwrite_guards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_ref", "predicate"],
        "properties": {
          "subject_ref": {"type": "string"},
          "predicate": {"type": "string"}
        }
      }
    },
    "review_routes": {"type": "array", "items": {"type": "string"}},
    "search_resolutions": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinema-and-series.local/schemas/validation-case-v0.2.json",
  "title": "Cinema and Series Validation Case v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "title",
    "status",
    "cohorts",
    "risk_level",
    "evidence",
    "expected_outcome",
    "assertions"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^VC-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "evidence_upgrade_needed",
        "open_adjudication",
        "gold_candidate",
        "gold",
        "retired_with_reason"
      ]
    },
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_ref", "entity_kind", "label"],
        "properties": {
          "local_ref": { "type": "string" },
          "entity_kind": {
            "type": "string",
            "enum": [
              "work",
              "version",
              "series",
              "season",
              "episode",
              "special",
              "structure_edition",
              "person",
              "organization",
              "release_event",
              "country",
              "language",
              "source_element",
              "external_creative_work",
              "musical_work",
              "music_recording",
              "soundtrack_release",
              "other"
            ]
          },
          "label": { "type": "string" },
          "external_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["provider", "value"],
              "properties": {
                "provider": { "type": "string" },
                "value": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "grade", "source_name", "url", "supports"],
        "properties": {
          "evidence_id": { "type": "string" },
          "grade": {
            "type": "string",
            "enum": ["A", "B", "C"]
          },
          "source_name": { "type": "string" },
          "source_kind": {
            "type": "string",
            "enum": [
              "first_party",
              "legal_record",
              "certification_authority",
              "festival",
              "archive",
              "institutional_catalog",
              "open_dataset",
              "licensed_provider",
              "trade_press",
              "reference",
              "other"
            ]
          },
          "url": { "type": "string", "format": "uri" },
          "published_or_effective_date": {
            "type": ["string", "null"]
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "expected_outcome": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "domain", "operator", "expected"],
        "properties": {
          "assertion_id": { "type": "string" },
          "domain": {
            "type": "string",
            "enum": [
              "identity",
              "relationship",
              "title",
              "localization",
              "release",
              "production_lifecycle",
              "version",
              "credit",
              "person_identity",
              "series_structure",
              "episode_order",
              "organization",
              "country",
              "preservation",
              "search",
              "canonicalization",
              "review_routing"
            ]
          },
          "operator": {
            "type": "string",
            "enum": [
              "same_identity",
              "different_identity",
              "has_relationship",
              "does_not_have_relationship",
              "has_value",
              "does_not_overwrite",
              "preserves_claims",
              "resolves_search",
              "routes_to_review",
              "supports_multiple",
              "custom"
            ]
          },
          "subject_ref": { "type": ["string", "null"] },
          "object_ref": { "type": ["string", "null"] },
          "predicate": { "type": ["string", "null"] },
          "expected": {},
          "notes": { "type": "string" }
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "type": ["string", "null"],
          "enum": [
            "pass_expected_model",
            "model_change_required",
            "evidence_upgrade_required",
            "expected_outcome_changed",
            "deferred",
            null
          ]
        },
        "reason": { "type": "string" },
        "reviewed_by": { "type": "array", "items": { "type": "string" } },
        "reviewed_at": { "type": ["string", "null"] },
        "related_adrs_or_specs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "string" }
  }
}
